# dependencies
node_modules/
.pnpm-store/

# NOTE: vault/shots/ is deliberately NOT ignored. The screenshots are the point
# of this repo — they are the evidence behind every taste note. Commit them.

# build / tooling
dist/
build/
.cache/
*.log
test-results/
playwright-report/

# env
.env
.env.*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local agent config (not part of the taste system)
.claude/

# ── visual acceptance evidence and previews ───────────────────────────────
# Browser screenshots, contact sheets and preview captures are reproducible from
# the page they were taken of. They are NOT evidence about taste and do not
# belong in this repository.
#
# vault/shots/ stays tracked — see the note above. That is the one exception,
# and it is deliberate: those screenshots ARE the evidence.
screenshots/
evidence/
contact-sheet*
*-preview.*
*.png
!vault/shots/**

# ── client and implementation work ────────────────────────────────────────
# This repository holds the taste system, not the sites it is used on.
homepage/
site/
client/
backup-*/

# ── scratch ───────────────────────────────────────────────────────────────
_*.mjs
*.tgz
tmp/
