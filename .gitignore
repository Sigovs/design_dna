# dependencies
node_modules/
.pnpm-store/

# NOTE: vault/shots/ is deliberately NOT ignored. The screenshots are the point
# of this repo — they are the evidence behind every taste note. Commit them.

# build / tooling
dist/
build/
.cache/
*.log
test-results/
playwright-report/

# env
.env
.env.*

# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local agent config (not part of the taste system)
.claude/

# ── visual acceptance evidence and previews ───────────────────────────────
# Browser screenshots, contact sheets and preview captures are reproducible from
# the page they were taken of. They are NOT evidence about taste and do not
# belong in this repository.
#
# vault/shots/ stays tracked — see the note above. That is the one exception,
# and it is deliberate: those screenshots ARE the evidence.
#
# Anchored to the root on purpose. An unanchored `screenshots/` matches a
# directory of that name at every level, which silently swallowed the shots an
# EXPLORE round is supposed to keep (explore/README.md).
/screenshots/
evidence/
contact-sheet*
*-preview.*
*.png
!vault/shots/**
!explore/**/*.png

# The browser tool's own scratch directory — page snapshots, console logs and
# capture probes. Same reasoning as the block above: reproducible from the page
# they were taken of. The rule already covered its .png and .log files, so the
# directory kept showing up as one stray untracked entry carrying .yml.
.playwright-mcp/

# ── generated art ─────────────────────────────────────────────────────────
# Project artefacts, not evidence — see skills/generated-imagery (GI6). The
# prompt is the part that survives, so prompts.md stays tracked and the frames
# do not. `*.png` is already caught by the rule above; these are not.
projects/art/**/*.jpg
projects/art/**/*.jpeg
projects/art/**/*.webp

# ── client and implementation work ────────────────────────────────────────
# This repository holds the taste system, not the sites it is used on.
homepage/
site/
client/
backup-*/

# ── scratch ───────────────────────────────────────────────────────────────
_*.mjs
*.tgz
tmp/
